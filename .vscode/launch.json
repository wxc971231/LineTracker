{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python 调试程序: 当前文件",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal",
            "envFile": "${workspaceFolder}/method/SimpleCNN/.env"
        },
        {
            "name": "SimpleCNN · CPU训练",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/method/SimpleCNN/train/train_ddp.py",
            "args": [
                "--config",
                "debug",
                "--set",
                "wandb_mode=disabled"
            ],
            "cwd": "${workspaceFolder}/method/SimpleCNN",
            "envFile": "${workspaceFolder}/method/SimpleCNN/.env",
            "console": "integratedTerminal",
            "justMyCode": false,
            "env": {
                "LT_ACCELERATOR": "cpu",
                "LT_DISTRIBUTED_BACKEND": "gloo",
                "LT_AMP": "off",
                "TORCH_DEVICE_BACKEND_AUTOLOAD": "0"
            }
        },
        {
            "name": "SimpleCNN · 单卡训练 · debug",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/method/SimpleCNN/train/train_ddp.py",
            "args": [
                "--config",
                "debug",
                "--set",
                "wandb_mode=disabled"
            ],
            "cwd": "${workspaceFolder}/method/SimpleCNN",
            "envFile": "${workspaceFolder}/method/SimpleCNN/.env",
            "console": "integratedTerminal",
            "justMyCode": false,
            "env": {
                "CUDA_VISIBLE_DEVICES": "0",
                "ASCEND_RT_VISIBLE_DEVICES": "0"
            }
        },
        {
            "name": "SimpleCNN · 多卡评估 · CUDA/NPU auto",
            "type": "debugpy",
            "request": "launch",
            "module": "runtime.launch",
            "args": [
                "eval/eval_ddp.py"
            ],
            "cwd": "${workspaceFolder}/method/SimpleCNN",
            "envFile": "${workspaceFolder}/method/SimpleCNN/.env",
            "console": "integratedTerminal",
            "justMyCode": false,
            "subProcess": false,
            "env": {
                "CUDA_VISIBLE_DEVICES": "0,1,4,5",
                "ASCEND_RT_VISIBLE_DEVICES": "6,7,8,9,12,13"
            }
        },
        {
            "name": "SimpleCNN · 多卡正式训练 · auto",
            "type": "debugpy",
            "request": "launch",
            "module": "runtime.launch",
            "args": [
                "train/train_ddp.py",
                "--config",
                "simplecnn_v2"
            ],
            "cwd": "${workspaceFolder}/method/SimpleCNN",
            "envFile": "${workspaceFolder}/method/SimpleCNN/.env",
            "console": "integratedTerminal",
            "justMyCode": false,
            "subProcess": false,
            "env": {
                "CUDA_VISIBLE_DEVICES": "0,1,4,5",
                "ASCEND_RT_VISIBLE_DEVICES": "0,1,2,3"
            }
        },
        {
            "name": "SimpleCNN · 单卡推理 · CUDA/NPU auto",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/method/SimpleCNN/infer/run_infer.py",
            "args": [
                "--device",
                "auto"
            ],
            "cwd": "${workspaceFolder}/method/SimpleCNN",
            "envFile": "${workspaceFolder}/method/SimpleCNN/.env",
            "console": "integratedTerminal",
            "justMyCode": false,
            "subProcess": false,
            "env": {
                "CUDA_VISIBLE_DEVICES": "0",
                "ASCEND_RT_VISIBLE_DEVICES": "0"
            }
        },
        {
            "name": "SimpleCNN · 单卡纯背景虚警评估 · CUDA/NPU auto",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/method/SimpleCNN/infer/run_FA_eval.py",
            "args": [
                "--device",
                "auto",
                "--no-warmup"
            ],
            "cwd": "${workspaceFolder}/method/SimpleCNN",
            "envFile": "${workspaceFolder}/method/SimpleCNN/.env",
            "console": "integratedTerminal",
            "justMyCode": false,
            "subProcess": false,
            "env": {
                "CUDA_VISIBLE_DEVICES": "0",
                "ASCEND_RT_VISIBLE_DEVICES": "0"
            }
        },
        {
            "name": "SimpleCNN · 多 NPU 样本并行推理 · 全部可见 Chip",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/method/SimpleCNN/infer/run_infer_parallel.py",
            "args": [
                "--method",
                "adaptive_tracker"
            ],
            "cwd": "${workspaceFolder}/method/SimpleCNN",
            "envFile": "${workspaceFolder}/method/SimpleCNN/.env",
            "console": "integratedTerminal",
            "justMyCode": false,
            "subProcess": true,
            "env": {
                "CUDA_VISIBLE_DEVICES": "0",
                "ASCEND_RT_VISIBLE_DEVICES": "2,3,12,13,14,15"
            }
        },
        {
            "name": "SimpleCNN · 多 NPU 纯背景虚警评估 · 全部可见 Chip",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/method/SimpleCNN/infer/run_FA_eval_parallel.py",
            "args": [
                "--no-warmup"
            ],
            "cwd": "${workspaceFolder}/method/SimpleCNN",
            "envFile": "${workspaceFolder}/method/SimpleCNN/.env",
            "console": "integratedTerminal",
            "justMyCode": false,
            "subProcess": false,
            "env": {
                "CUDA_VISIBLE_DEVICES": "0",
                "ASCEND_RT_VISIBLE_DEVICES": "2,3,6,7,8,9,12,13"
            }
        }
    ]
}
