{
    // 使用 IntelliSense 了解相关属性。
    // 悬停以查看现有属性的描述。
    // 欲了解更多信息，请访问: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python 调试程序: 当前文件",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal"
        },
        {
            "name": "SimpleCNN · CPU · debug",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/method/SimpleCNN/train/train_ddp.py",
            "args": ["--config", "debug", "--set", "wandb_mode=disabled"],
            "cwd": "${workspaceFolder}/method/SimpleCNN",
            "envFile": "${workspaceFolder}/method/SimpleCNN/.env",
            "env": {
                "LT_ACCELERATOR": "cpu",
                "LT_AMP": "off"
            },
            "console": "integratedTerminal",
            "justMyCode": false
        },
        {
            "name": "SimpleCNN · 单卡 debug · auto",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/method/SimpleCNN/train/train_ddp.py",
            "args": ["--config", "debug", "--set", "wandb_mode=disabled"],
            "cwd": "${workspaceFolder}/method/SimpleCNN",
            "envFile": "${workspaceFolder}/method/SimpleCNN/.env",
            "env": {
                "LT_ACCELERATOR": "auto",
                "CUDA_VISIBLE_DEVICES": "0",
                "ASCEND_RT_VISIBLE_DEVICES": "0"
            },
            "console": "integratedTerminal",
            "justMyCode": false
        },
        {
            "name": "SimpleCNN · 多卡评估 · CUDA/NPU auto",
            "type": "debugpy",
            "request": "launch",
            "module": "runtime.launch",
            "args": [
                "eval/eval_ddp.py",
            ],
            "cwd": "${workspaceFolder}/method/SimpleCNN",
            "envFile": "${workspaceFolder}/method/SimpleCNN/.env",
            "env": {
                "LT_ACCELERATOR": "auto",
                "CUDA_VISIBLE_DEVICES": "0,1,4,5",
                "ASCEND_RT_VISIBLE_DEVICES": "0,1,2,3,4,5,14,15",
                "HCCL_IF_BASE_PORT": "62000",
                "OMP_NUM_THREADS": "1",
                "ASCEND_GLOBAL_LOG_LEVEL": "3"
            },
            "console": "integratedTerminal",
            "justMyCode": false,
            "subProcess": false
        },
        {
            "name": "SimpleCNN · 多卡正式训练 · auto",
            "type": "debugpy",
            "request": "launch",
            "module": "runtime.launch",
            "args": [
                "train/train_ddp.py",
                "--config",
                "simplecnn_v1"
            ],
            "cwd": "${workspaceFolder}/method/SimpleCNN",
            "envFile": "${workspaceFolder}/method/SimpleCNN/.env",
            "env": {
                "LT_ACCELERATOR": "auto",
                "CUDA_VISIBLE_DEVICES": "0,1,4,5",
                "ASCEND_RT_VISIBLE_DEVICES": "0,1,2,3,4,5,14,15",
                "HCCL_IF_BASE_PORT": "62000",
                "OMP_NUM_THREADS": "1",
                "ASCEND_GLOBAL_LOG_LEVEL": "3"
            },
            "console": "integratedTerminal",
            "justMyCode": false,
            "subProcess": false
        }
    ]
}
