# 具体批次目录，其下每个样本目录包含 data.npz
LT_DATA_ROOT=/SharePath/weixc/workspace/projects/LineTracker/data/synthetic/gen/F300_N50000_S20260717_B-random_T-R10000-290000m-V340-A6-C10-J1-K300-Q0p35-0p95 # 训练数据批次目录；一级子目录中应包含 data.npz

# 训练输出根目录
LT_OUTPUT_ROOT=/SharePath/weixc/workspace/projects/LineTracker/method/SimpleCNN/runs # 训练日志、配置和 checkpoint 的输出根目录

# W&B 反向代理服务地址。
WANDB_BASE_URL=https://api.bandw.top # W&B API 反向代理地址，不是 API Key

# 本机 Conda 安装和环境位置（供仓库 activate_env.sh 使用）。
LT_CONDA_SH=/opt/conda/etc/profile.d/conda.sh               # Conda Shell 初始化脚本，供 activate_env.sh 使用
LT_CONDA_PREFIX=/SharePath/weixc/.conda/linetracker-py311   # 本机 Conda 环境目录，换机器时调整

# 驱动与 CANN 正式运行库；不要加入 devlib。
LD_LIBRARY_PATH=/usr/local/Ascend/driver/lib64/driver:/usr/local/Ascend/driver/lib64/common:/usr/local/Ascend/driver/lib64:/usr/local/Ascend/cann-9.0.0/lib64 # 动态库按从左到右查找；优先真实驱动和 CANN 运行库，排除 devlib
PYTHONNOUSERSITE=1                                      # 1 禁用用户级 site-packages，避免混入其他环境的包
MPLCONFIGDIR=/SharePath/weixc/.conda/cache/matplotlib   # Matplotlib 配置与字体缓存目录，需可写

# 各任务共用的运行时默认值；卡号在 launch.json 各启动项中单独设置。
LT_ACCELERATOR=auto                 # auto 自动选择设备；可选 cuda、npu、cpu；CPU 启动项会覆盖
LT_DISTRIBUTED_BACKEND=auto         # auto 按设备选择 nccl、hccl 或 gloo
LT_AMP=auto                         # auto 优先 BF16，不支持则 FP16；可选 bf16、fp16、off
LT_PIN_MEMORY=auto                  # auto 使用设备默认值，非 CUDA 默认关闭；可选 true、false
LT_DISTRIBUTED_TIMEOUT_MINUTES=10   # 分布式操作等待超时，单位分钟，必须为正整数
HCCL_IF_BASE_PORT=62000             # Ascend HCCL 通信基础端口，多任务冲突时调整
OMP_NUM_THREADS=1                   # 每个进程的 OpenMP 线程数，避免多进程线程争用
ASCEND_GLOBAL_LOG_LEVEL=3           # Ascend 日志级别；3 为 ERROR
